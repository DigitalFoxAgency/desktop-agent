{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentplatform.dev/schemas/module.schema.json",
  "title": "AgentPlatform Module Manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "name", "workflows"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [2] },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "phases"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "kind"],
              "properties": {
                "name": { "type": "string" },
                "kind": { "type": "string", "enum": ["string", "path", "url", "number", "boolean"] },
                "required": { "type": "boolean" },
                "description": { "type": "string" }
              }
            }
          },
          "phases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name", "role", "skill", "kind"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "role": { "type": "string", "enum": ["admin", "marketer", "strategist", "designer", "engineer", "media-buyer"] },
                "skill": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "enum": ["standard", "verification", "manual"] },
                "verificationKey": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actionClass", "classification", "reason"],
        "properties": {
          "actionClass": { "type": "string", "enum": ["DeleteFile", "GitPush", "InstallPackage", "RunShell", "BuildClass"] },
          "classification": { "type": "string", "enum": ["safe", "dangerous"] },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
