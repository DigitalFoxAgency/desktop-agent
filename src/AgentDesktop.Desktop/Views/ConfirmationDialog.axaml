<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:aut="using:Avalonia.Automation"
        x:Class="AgentDesktop.Desktop.Views.ConfirmationDialog"
        Title="Confirm action"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        aut:AutomationProperties.Name="Dangerous action confirmation">

    <Border Padding="20">
        <StackPanel Spacing="16">
            <TextBlock x:Name="HeadingText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Action:" Opacity="0.7" Margin="0,0,12,6" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           x:Name="KindText"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"
                           aut:AutomationProperties.Name="Action kind" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Target:" Opacity="0.7" Margin="0,0,12,0" />
                <SelectableTextBlock Grid.Row="1" Grid.Column="1"
                                     x:Name="TargetText"
                                     TextWrapping="Wrap"
                                     aut:AutomationProperties.Name="Action target" />
            </Grid>

            <TextBlock Text="This action will modify your machine. Confirm only if you expect it."
                       Opacity="0.85"
                       TextWrapping="Wrap" />

            <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0"
                        x:Name="DeclineButton"
                        Content="Decline"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Click="OnDecline"
                        IsCancel="True"
                        aut:AutomationProperties.Name="Decline action" />
                <Button Grid.Column="1"
                        x:Name="ConfirmButton"
                        Content="Confirm"
                        Margin="6,0,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Click="OnConfirm"
                        IsDefault="True"
                        Classes="accent"
                        aut:AutomationProperties.Name="Confirm action" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
