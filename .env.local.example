# Copy to .env.local and fill in. Source via `set -a; source .env.local; set +a`
# before `dotnet run`. Names use the .NET config-key convention (`Section__Key`)
# so .NET binds them directly with no aliasing — match them exactly.

# --- API server ---

# Where Kestrel binds. The web client + per-run bridge containers expect 5080.
ASPNETCORE_URLS=http://localhost:5080

# Postgres connection string. MUST be quoted — bash treats `;` as a command
# separator inside `set -a; source`. Default user/password come from
# docker-compose.yml's postgres service.
ConnectionStrings__Postgres="Host=localhost;Port=5432;Database=agentplatform;Username=agentplatform;Password=agentplatform_dev"

# --- Auth ---

# JWT signing secret. Generate with: openssl rand -base64 48
Jwt__SigningKey=replace-with-openssl-rand-base64-48-output

# --- Vault (encrypted secret storage) ---

# AES-GCM master key. Generate with: openssl rand -base64 32
AgentPlatform__Vault__KeyBase64=replace-with-openssl-rand-base64-32-output

# --- Docker (per-run claude containers) ---

# Path to the host Docker socket. Docker Desktop on macOS:
AgentPlatform__Docker__Endpoint=unix:///Users/$(whoami)/.docker/run/docker.sock
# Linux:
# AgentPlatform__Docker__Endpoint=unix:///var/run/docker.sock

# --- Anthropic credentials ---

# Real key with credits. Without one, claude in the run container 401s with
# "Not logged in / run /login" or stalls on "Credit balance is too low".
AgentPlatform__PhaseSession__AnthropicApiKey=sk-ant-api03-...

# Skip every permission prompt — claude runs full-auto and the Bridge
# auto-forwards every tool-use without showing a confirmation dialog.
# Trade-off: no protection if claude does something dumb. Keep this off
# (omit, or set to `ask`) before pointing it at real client repos.
AgentPlatform__PhaseSession__ClaudePermissionMode=bypassPermissions

# --- Paths (host dev only) ---

# The compose-baked defaults under /var/lib/agentplatform/* are only writable
# inside the api container. On host `dotnet run` you must point them at
# user-writable paths. Replace with your own absolute paths:
AgentPlatform__ModulesRoot=/absolute/path/to/repo/modules
AgentPlatform__Vault__Directory=/absolute/path/to/repo/.local/vault
AgentPlatform__Runs__Root=/absolute/path/to/repo/.local/runs
AgentPlatform__Runs__ArchiveRoot=/absolute/path/to/repo/.local/archive
