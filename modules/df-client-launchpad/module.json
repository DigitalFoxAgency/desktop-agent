{
  "schemaVersion": 2,
  "id": "df-client-launchpad",
  "version": "0.2.0",
  "name": "Digital Fox Client Launchpad",
  "description": "Multi-role agency workflow: client onboarding from intake through Cloudflare Pages deployment, then ads launch and monthly reporting. Each phase runs the matching skill from source/template/.claude/skills/<id>/SKILL.md inside the assigned role-holder's session.",
  "dependencies": [],
  "workflows": [
    {
      "id": "onboard-client",
      "name": "Onboard Client",
      "description": "Full client onboarding pipeline: intake → research → strategy → design → site → integrations → SEO → deploy.",
      "inputs": [
        { "name": "niche", "kind": "string", "required": true, "description": "Client niche / vertical." },
        { "name": "city", "kind": "string", "required": true, "description": "Client city." },
        { "name": "clientName", "kind": "string", "required": true, "description": "Client display name." }
      ],
      "phases": [
        { "id": "init",          "name": "Init client project",        "role": "engineer",    "skill": "init",          "kind": "verification", "verificationKey": "init: verified" },
        { "id": "pre-research",  "name": "Pre-research",               "role": "marketer",    "skill": "pre-research",  "kind": "standard",     "verificationKey": "pre-research: verified" },
        { "id": "brief",         "name": "Discovery brief",            "role": "strategist",  "skill": "brief",         "kind": "manual",       "verificationKey": "brief: verified" },
        { "id": "research",      "name": "Deep research",              "role": "strategist",  "skill": "research",      "kind": "standard",     "verificationKey": "research: verified" },
        { "id": "semantics",     "name": "Semantics + budget",         "role": "strategist",  "skill": "semantics",     "kind": "standard",     "verificationKey": "semantics: verified" },
        { "id": "strategy",      "name": "Strategy",                   "role": "strategist",  "skill": "strategy",      "kind": "standard",     "verificationKey": "strategy: verified" },
        { "id": "strategy-pdf",  "name": "Strategy PDF",               "role": "strategist",  "skill": "strategy-pdf",  "kind": "standard",     "verificationKey": "strategy-pdf: verified" },
        { "id": "offer",         "name": "Offer",                      "role": "strategist",  "skill": "offer",         "kind": "manual",       "verificationKey": "offer: verified" },
        { "id": "architecture",  "name": "Site architecture",          "role": "strategist",  "skill": "architecture",  "kind": "standard",     "verificationKey": "architecture: verified" },
        { "id": "design",        "name": "Design system",              "role": "designer",    "skill": "design",        "kind": "standard",     "verificationKey": "design: verified" },
        { "id": "site",          "name": "Build Astro site",           "role": "engineer",    "skill": "site",          "kind": "standard",     "verificationKey": "site: verified" },
        { "id": "integrations",  "name": "Integrations",               "role": "engineer",    "skill": "integrations",  "kind": "standard",     "verificationKey": "integrations: verified" },
        { "id": "seo",           "name": "SEO audit",                  "role": "engineer",    "skill": "seo",           "kind": "verification", "verificationKey": "seo: verified" },
        { "id": "deploy",        "name": "Deploy to Cloudflare Pages", "role": "engineer",    "skill": "deploy",        "kind": "standard",     "verificationKey": "deploy: verified" }
      ]
    },
    {
      "id": "launch-ads",
      "name": "Launch Ads",
      "description": "Configure and launch Google Ads / Meta Ads once the site is live.",
      "inputs": [
        { "name": "clientPath", "kind": "path", "required": true, "description": "Absolute path to the client folder created by onboard-client." }
      ],
      "phases": [
        { "id": "ads", "name": "Launch ads", "role": "media-buyer", "skill": "ads", "kind": "manual", "verificationKey": "ads: verified" }
      ]
    },
    {
      "id": "monthly-report",
      "name": "Monthly Report",
      "description": "Recurring optimisation pass and monthly client report.",
      "inputs": [
        { "name": "clientPath", "kind": "path", "required": true, "description": "Absolute path to the client folder." }
      ],
      "phases": [
        { "id": "reporting", "name": "Monthly reporting", "role": "media-buyer", "skill": "reporting", "kind": "standard", "verificationKey": "reporting: verified" }
      ]
    }
  ],
  "policies": [
    { "actionClass": "DeleteFile",     "classification": "dangerous", "reason": "Launchpad rewrites client files during site build / strategy generation; deletions are real." },
    { "actionClass": "GitPush",        "classification": "dangerous", "reason": "Launchpad pushes generated code to client GitHub repos." },
    { "actionClass": "InstallPackage", "classification": "dangerous", "reason": "Launchpad installs npm dependencies during site build." },
    { "actionClass": "RunShell",       "classification": "dangerous", "reason": "Launchpad runs shell commands (git, npm, deploy CLI) inside the client folder." }
  ]
}
