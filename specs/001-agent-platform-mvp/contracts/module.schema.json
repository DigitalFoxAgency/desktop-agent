{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentdesktop.local/schemas/module.schema.json",
  "title": "Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "name", "description", "operations"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 2,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },

    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" }
        }
      },
      "default": []
    },

    "operations": {
      "description": "Platform-visible entry points the platform may delegate to. Required: a module without operations cannot be invoked.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 },
          "inputs": { "$ref": "#/$defs/parameterArray" }
        }
      }
    },

    "skills": {
      "description": "OPTIONAL. Internal implementation detail surfaced for catalogue introspection / advanced direct invocation. The platform does NOT orchestrate skills — see research.md R18.",
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "classification"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "classification": { "type": "string", "enum": ["safe", "dangerous"] },
          "kind": { "type": "string", "enum": ["automated", "human"], "default": "automated" },
          "sourcePath": { "type": "string", "description": "Relative path within the module root to the authoritative skill contract (e.g. SKILL.md). For developer reference; the platform does not invoke this." },
          "inputs": { "$ref": "#/$defs/parameterArray" },
          "outputs": { "$ref": "#/$defs/parameterArray" }
        }
      }
    },

    "mcpServers": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command"],
        "properties": {
          "name": { "type": "string" },
          "command": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" }, "default": [] },
          "env": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "default": {}
          }
        }
      }
    },

    "prompts": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "body"],
        "properties": {
          "name": { "type": "string" },
          "body": { "type": "string" }
        }
      }
    },

    "policies": {
      "description": "Per-action-class policy overrides the module declares for the platform's policy engine. The module proposes individual dangerous actions at runtime via IDelegationCallbacks.RequestConfirmationAsync; these declarations let the engine pre-classify and explain each class to the user.",
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actionClass", "classification"],
        "properties": {
          "actionClass": { "type": "string", "description": "Either a baseline DangerousActionKind name (DeleteFile / GitPush / InstallPackage / RunShell) or a module-defined class string." },
          "classification": { "type": "string", "enum": ["safe", "dangerous"] },
          "reason": { "type": "string" }
        }
      }
    }
  },

  "$defs": {
    "parameterArray": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["string", "integer", "number", "boolean", "path", "url", "json"]
          },
          "required": { "type": "boolean", "default": false },
          "description": { "type": "string" }
        }
      }
    }
  }
}
